# Required: an OpenAI-compatible chat completions endpoint whose model accepts video.
VIDEO_BASE_URL=https://your-endpoint.example/v1
VIDEO_MODEL=your-video-capable-model
# Optional: sent as "Authorization: Bearer <key>". Leave unset for endpoints without auth.
VIDEO_API_KEY=your-endpoint-api-key
# Optional: extra headers for endpoint requests, as a JSON object, for example a
# Cloudflare Access service token. Cannot set Authorization, Accept, or Content-Type.
# VIDEO_EXTRA_HEADERS={"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}

# How the video is attached to the request: image_url (default), video_url, file, or input_file.
# See the README for which providers use which format.
# VIDEO_PART_FORMAT=image_url

# Optional limits (defaults shown). Invalid values stop the server at startup.
# VIDEO_MAX_DURATION_SECONDS=300
# VIDEO_MAX_UPLOAD_MB=15
# VIDEO_MAX_DOWNLOAD_MB=500
# VIDEO_REQUEST_TIMEOUT_MS=180000
# VIDEO_MAX_CONCURRENCY=2
# VIDEO_MAX_OUTPUT_TOKENS=8192

# Fail calls when the endpoint evidently ignored the video (default true).
# VIDEO_VERIFY_MEDIA=true

# Local files are refused unless their directories are listed here
# (separated by ":" on macOS/Linux and ";" on Windows).
# VIDEO_ALLOWED_DIRS=/path/to/videos

# Allow downloads from loopback and private addresses (default false).
# VIDEO_ALLOW_PRIVATE_NETWORK=false

# Executable names or paths (defaults shown).
# VIDEO_FFMPEG_PATH=ffmpeg
# VIDEO_FFPROBE_PATH=ffprobe
# VIDEO_YTDLP_PATH=yt-dlp

# Used only by npm run test:live.
# VIDEO_LIVE_BASE_URL=
# VIDEO_LIVE_API_KEY=
# VIDEO_LIVE_MODEL=
# VIDEO_LIVE_PART_FORMAT=image_url
# VIDEO_LIVE_SOURCE=
# VIDEO_LIVE_EXPECT=ok
# VIDEO_LIVE_VERIFY_MEDIA=true
# VIDEO_LIVE_QUESTION=
